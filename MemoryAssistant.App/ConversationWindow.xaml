<Window x:Class="MemoryAssistant.App.ConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="聊天记录"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource OverlayBrush}" MouseLeftButtonDown="Overlay_Click">
        <Border x:Name="DialogCard"
                Width="960" MaxHeight="720"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                MouseLeftButtonDown="Card_Click"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform Y="16" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.5" ShadowDepth="6" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题：会话 + 日期 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TextSectionStyle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="660" />
                    <TextBlock x:Name="SubText" Style="{StaticResource TextMetaStyle}"
                               Margin="10,2,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 你点开的那一条（定位目标） -->
                <Border Grid.Row="1" Padding="12" CornerRadius="10" Margin="0,0,0,10"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource BrandVividBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="你点开的是这一条" FontWeight="SemiBold"
                                   Style="{StaticResource TextMicroStyle}"
                                   Foreground="{StaticResource MintBrush}" />
                        <TextBlock x:Name="TargetText" Style="{StaticResource TextMetaStyle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 当天对话（仿微信：自己右侧、对方左侧；图片/语音/表情按类型渲染） -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <ListBox x:Name="MessageList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding TimeSeparator}" FontSize="11" Margin="0,10,0,6"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Visibility="{Binding HasSeparator, Converter={StaticResource BoolToVisibility}}" />

                                    <Border Margin="0,3" Padding="12,9" CornerRadius="12" MaxWidth="620"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Background" Value="{StaticResource AssistantBubbleBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                        <Setter Property="Background" Value="{StaticResource UserBubbleBrush}" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                    </DataTrigger>
                                                    <!-- 定位到的那条：加个强调边，一眼看到 -->
                                                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Sender}" Style="{StaticResource TextMicroStyle}" Margin="0,0,0,4"
                                                       Foreground="{StaticResource MintBrush}"
                                                       Visibility="{Binding ShowSender, Converter={StaticResource BoolToVisibility}}" />

                                            <!-- 图片 / 表情包图片：原样显示，点击看大图 -->
                                            <Image Source="{Binding ImagePath, Converter={StaticResource PathToImageConverter}}"
                                                   MaxWidth="240" MaxHeight="240" Stretch="Uniform"
                                                   HorizontalAlignment="Left" Margin="0,0,0,4"
                                                   Cursor="Hand" MouseLeftButtonUp="Image_Click"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" />

                                            <TextBlock Text="{Binding Text}" Style="{StaticResource TextParagraphStyle}"
                                                       Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}" />

                                            <!-- 语音：可播放 -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding HasAudio, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="🔊 播放语音" Click="PlayVoice_Click" Cursor="Hand"
                                                        Style="{StaticResource GhostButtonStyle}" Height="26" Padding="10,0"
                                                        DataContext="{Binding}" />
                                            </StackPanel>

                                            <!-- 未能图形化的类型：如实说明，不装作没有 -->
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource TextMicroStyle}" Margin="0,4,0,0"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />

                                            <TextBlock Text="{Binding Time}" Style="{StaticResource TextMicroStyle}" Margin="0,4,0,0"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="▲ 定位到这里" Style="{StaticResource TextMicroStyle}" Margin="0,0,0,2"
                                               HorizontalAlignment="Left"
                                               Foreground="{StaticResource MintBrush}"
                                               Visibility="{Binding IsTarget, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource TextMicroStyle}" />
                    <Button Content="关闭" Style="{StaticResource AccentButtonStyle}" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
