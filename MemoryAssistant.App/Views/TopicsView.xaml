<UserControl x:Class="MemoryAssistant.App.Views.TopicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MemoryAssistant.App.ViewModels"
             xmlns:views="clr-namespace:MemoryAssistant.App.Views"
             d:DataContext="{d:DesignInstance Type=vm:TopicsViewModel}"
             mc:Ignorable="d"
             Loaded="OnLoaded">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="最近" VerticalAlignment="Center" Style="{StaticResource TextMetaStyle}" />
            <ComboBox Width="64" Margin="6,0" VerticalAlignment="Center"
                      ItemsSource="{Binding DayOptions}" SelectedItem="{Binding RecentDays}" />
            <TextBlock Text="天" VerticalAlignment="Center" Style="{StaticResource TextMetaStyle}" />
            <Button Content="分析" Command="{Binding AnalyzeCommand}" Margin="12,0,0,0"
                    Style="{StaticResource AccentButtonStyle}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{StaticResource TextMetaStyle}" />
            <TextBlock Text="{Binding Refresh.Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{StaticResource TextMetaStyle}" FontSize="11" Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 主题列表 -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}"
                     VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold"
                                       Style="{StaticResource TextBodyStyle}" />
                            <TextBlock Text="{Binding KindTag}" Style="{StaticResource TextMicroStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 每日分布 -->
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedPerDay}" VirtualizingStackPanel.IsVirtualizing="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Date}" Style="{StaticResource TextMicroStyle}" />
                                <Rectangle Grid.Column="1" Height="10" Margin="6,0" RadiusX="3" RadiusY="3"
                                           Fill="{StaticResource BrandVividBrush}"
                                           Width="{Binding Count, Converter={StaticResource CountToWidthConverter}}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource TextMicroStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 消息片段 -->
            <ScrollViewer Grid.Column="2" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedSamples}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                        <Button Margin="0,0,0,8" Padding="12" HorizontalContentAlignment="Stretch"
                                Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                Cursor="Hand" Click="Sample_Click">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource TextBodyStyle}">
                                    <Run Text="{Binding SessionName, Mode=OneWay}" /> · <Run Text="{Binding Date, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" Margin="0,4,0,0"
                                           Style="{StaticResource TextPreviewStyle}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态 -->
            <views:EmptyStateView Grid.Column="0" Grid.ColumnSpan="3"
                                  Icon="Tag24"
                                  Title="还没有话题可看"
                                  Hint="话题来自本地索引近 N 天的聚合；先点「分析」，或在设置页做一次索引。">
                <views:EmptyStateView.Visibility>
                    <MultiBinding Converter="{StaticResource EmptyStateVisibility}">
                        <Binding Path="Topics" />
                        <Binding Path="IsBusy" />
                    </MultiBinding>
                </views:EmptyStateView.Visibility>
            </views:EmptyStateView>
        </Grid>
    </Grid>
</UserControl>
