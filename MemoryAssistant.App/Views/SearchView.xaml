<UserControl x:Class="MemoryAssistant.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MemoryAssistant.App.ViewModels"
             xmlns:views="clr-namespace:MemoryAssistant.App.Views"
             d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
             mc:Ignorable="d">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索框 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="输入关键词，如：社保" MinHeight="32"
                     KeyDown="Input_KeyDown" />
            <Button Grid.Column="1" Content="搜索" Command="{Binding SearchCommand}"
                    Margin="8,0,0,0" Width="72" Height="32"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding StatusText}" Style="{StaticResource TextMetaStyle}" Margin="0,0,0,8" />

            <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                     Background="Transparent" BorderThickness="0"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}"
                                Cursor="Hand" ToolTip="点一下：看这条消息所在的完整对话"
                                MouseLeftButtonUp="Result_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SessionName}" FontWeight="SemiBold"
                                               Style="{StaticResource TextBodyStyle}" />
                                    <TextBlock Text="{Binding Time}" Margin="12,0,0,0"
                                               Style="{StaticResource TextMetaStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Content}" Margin="0,4,0,0"
                                           Style="{StaticResource TextPreviewStyle}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态：没搜过 / 无结果时说清下一步，而不是留白（措辞别和上面的状态行重复） -->
            <views:EmptyStateView Grid.Row="1"
                                  Icon="Search24"
                                  Title="搜一段具体的聊天"
                                  Hint="按关键词搜本地原文，不联网；回车或点「搜索」都能执行。">
                <views:EmptyStateView.Visibility>
                    <MultiBinding Converter="{StaticResource EmptyStateVisibility}">
                        <Binding Path="Results" />
                        <Binding Path="IsBusy" />
                    </MultiBinding>
                </views:EmptyStateView.Visibility>
            </views:EmptyStateView>
        </Grid>
    </Grid>
</UserControl>
