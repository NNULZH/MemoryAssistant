<UserControl x:Class="MemoryAssistant.App.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MemoryAssistant.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:WorkflowViewModel}"
             mc:Ignorable="d">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
            <TextBlock Text="工作流" Style="{StaticResource TextTitleStyle}" />
            <TextBlock Text="Agent 的固定执行阶段，以及最近一次对话里真实走过的每一步"
                       Style="{StaticResource TextMetaStyle}" Margin="12,3,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- 左：固定阶段 + 最近一次执行回放 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 固定阶段 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Agent 工作流（固定阶段）" Style="{StaticResource TextSectionStyle}" />
                            <TextBlock Text="标「自主决策」的阶段由 Agent 自己判断怎么做；其余是确定性组件。"
                                       Style="{StaticResource TextMicroStyle}" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding Nodes}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Width="24">
                                                <Border Style="{StaticResource StepIndexStyle}"
                                                        BorderBrush="{StaticResource CardBorderBrush}">
                                                    <TextBlock Text="{Binding Index}" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource MintBrush}" />
                                                </Border>
                                                <Rectangle Style="{StaticResource StepConnectorStyle}" Height="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="{StaticResource TagRadius}"
                                                            Background="{StaticResource AccentSoftBrush}"
                                                            Visibility="{Binding Autonomous, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="自主决策" FontSize="10" Foreground="{StaticResource MintBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Component}" FontSize="11" Margin="0,3,0,0"
                                                           Foreground="{StaticResource SkyBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource TextPreviewStyle}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 最近一次执行回放（数据来自对话页，同一份） -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="最近一次执行（来自「对话」页）" Style="{StaticResource TextSectionStyle}" />
                                <Border Style="{StaticResource StatusDotStyle}" Margin="8,0,0,0"
                                        Background="{Binding Chat.ExecutionState, Converter={StaticResource StepStateToBrush}}" />
                                <TextBlock Text="{Binding Chat.ExecutionStatus}" Style="{StaticResource TextMicroStyle}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Chat.ExecutionQuery, StringFormat='本轮问题：{0}'}"
                                       Style="{StaticResource TextMicroStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource TextPreviewStyle}" Margin="0,10,0,0"
                                       Text="还没有执行记录。去「对话」页问一句（例如：我最近和谁聊得最多？），
这里会同步出现那一轮真实走过的每一步：调用哪个工具、参数是什么、拿到多少条结果、各花了多久。"
                                       Visibility="{Binding Chat.HasExecutionSteps, Converter={StaticResource InverseBoolVisibility}}" />

                            <ItemsControl ItemsSource="{Binding Chat.ExecutionSteps}" Margin="0,12,0,0"
                                          Visibility="{Binding Chat.HasExecutionSteps, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Width="24">
                                                <Border Style="{StaticResource StepIndexStyle}"
                                                        BorderBrush="{Binding Kind, Converter={StaticResource StepKindToBrush}}">
                                                    <TextBlock Text="{Binding Number}" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Kind, Converter={StaticResource StepKindToBrush}}" />
                                                </Border>
                                                <Rectangle Style="{StaticResource StepConnectorStyle}" Height="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Kind, Converter={StaticResource StepKindToBrush}}" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12" Margin="8,0,0,0"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding StateGlyph}" FontSize="11" Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding State, Converter={StaticResource StepStateToBrush}}" />
                                                    <TextBlock Text="{Binding Elapsed}" Style="{StaticResource TextMicroStyle}"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding HasElapsed, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <Border Style="{StaticResource KeyValueBlockStyle}"
                                                        Visibility="{Binding HasArgs, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel>
                                                        <TextBlock Text="参数" Style="{StaticResource PanelHeaderStyle}" />
                                                        <TextBlock Text="{Binding Args}" Style="{StaticResource MonoTextStyle}"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource KeyValueBlockStyle}"
                                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel>
                                                        <TextBlock Text="结果" Style="{StaticResource PanelHeaderStyle}" />
                                                        <TextBlock Text="{Binding Result}" Style="{StaticResource TextPreviewStyle}"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右：怎么读这一页 -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="本轮规模" Style="{StaticResource TextSectionStyle}" />
                        <TextBlock Text="{Binding Chat.ExecutionSummary, FallbackValue=尚无数据}"
                                   Style="{StaticResource TextParagraphStyle}" Margin="0,8,0,0"
                                   Foreground="{StaticResource MintBrush}" />
                        <TextBlock Text="{Binding Chat.ExecutionStatus}" Style="{StaticResource TextMicroStyle}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="这一页回答什么" Style="{StaticResource TextSectionStyle}" />
                        <TextBlock Style="{StaticResource TextPreviewStyle}" Margin="0,8,0,0"
                                   Text="· 上面那张图是 Agent 的固定阶段，不是示意图——每个阶段都对应真实组件。&#x0a;&#x0a;· 下面的时间线是刚才那一轮真实发生的事：调了哪个工具、参数是什么、拿到多少结果、各花了多久。&#x0a;&#x0a;· 两件事对起来看，就能确认它不是「问一句答一句」的聊天框，而是按阶段推进、会自己选工具的 Agent。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
