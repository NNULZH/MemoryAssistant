<UserControl x:Class="MemoryAssistant.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MemoryAssistant.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:OverviewViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,32">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Left">

            <!-- ============ 它是谁 / 现在什么状态 ============
                 不套卡片：打开软件第一眼看到的就是"这个 Agent 活着"。 -->
            <StackPanel>
                <TextBlock Text="{Binding AgentName}" Style="{StaticResource TextDisplayStyle}" />
                <TextBlock Text="{Binding Tagline}" Style="{StaticResource TextParagraphStyle}"
                           Margin="0,10,0,0" FontSize="15"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Border Style="{StaticResource StatusDotStyle}"
                            Background="{Binding AgentStatusState, Converter={StaticResource StepStateToBrush}}" />
                    <TextBlock Text="{Binding AgentStatusText}" Style="{StaticResource TextMetaStyle}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding IndexNote}" Style="{StaticResource TextMicroStyle}"
                               Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- ============ 规模：四个裸数字（不装进卡片） ============ -->
            <StackPanel Orientation="Horizontal" Margin="0,28,0,4">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="{Binding ToolCountText}" Style="{StaticResource StatNumberStyle}" />
                    <TextBlock Text="可调用工具" Style="{StaticResource StatLabelStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="0,6,40,10" />
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="{Binding MemoryCountText}" Style="{StaticResource StatNumberStyle}" />
                    <TextBlock Text="记忆片段" Style="{StaticResource StatLabelStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="0,6,40,10" />
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="{Binding SessionCountText}" Style="{StaticResource StatNumberStyle}" />
                    <TextBlock Text="已索引会话" Style="{StaticResource StatLabelStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="0,6,40,10" />
                <StackPanel>
                    <TextBlock Text="{Binding MissionText}" Style="{StaticResource StatNumberStyle}" />
                    <TextBlock Text="长期任务" Style="{StaticResource StatLabelStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding MissionNote}" Style="{StaticResource TextMicroStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- ============ 我的任务 / 环境 / 工具 三个入口 ============ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="开始对话" Click="GoChat_Click"
                        Style="{StaticResource AccentButtonStyle}" Height="38" Padding="22,0" Margin="0,0,10,0" />
                <Button Content="查看任务" Click="GoMissions_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="20,0" Margin="0,0,10,0" />
                <Button Content="环境与自检" Click="GoEnvironment_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="20,0" Margin="0,0,10,0" />
                <Button Content="知识库" Click="GoKnowledge_Click"
                        Style="{StaticResource GhostButtonStyle}" Height="38" Padding="16,0" Margin="0,0,10,0" />
                <Button Content="工具" Click="GoTools_Click"
                        Style="{StaticResource GhostButtonStyle}" Height="38" Padding="16,0" Margin="0,0,10,0" />
                <Button Content="工作流" Click="GoWorkflow_Click"
                        Style="{StaticResource GhostButtonStyle}" Height="38" Padding="16,0" />
            </StackPanel>

            <!-- ============ 最近动态：它刚才到底做了什么 ============ -->
            <Grid Margin="0,32,0,0">
                <TextBlock Text="最近动态" Style="{StaticResource TextSectionStyle}" VerticalAlignment="Center" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"
                        Style="{StaticResource GhostButtonStyle}" Height="30" Padding="12,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>
            <Border Style="{StaticResource CardBorderStyle}" Padding="4,4" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding Activities}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource MonoTextStyle}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBodyStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TextPreviewStyle}"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding Detail, Converter={StaticResource NullToCollapsedConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ============ 你可以让我……：点一下就问 ============ -->
            <TextBlock Text="你可以让我……" Style="{StaticResource TextSectionStyle}" Margin="0,28,0,0" />
            <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Click="Suggestion_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="36" Padding="16,0" Margin="0,0,10,10"
                                HorizontalContentAlignment="Left" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
