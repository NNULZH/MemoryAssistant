<UserControl x:Class="MemoryAssistant.App.Views.CommitmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MemoryAssistant.App.ViewModels"
             xmlns:views="clr-namespace:MemoryAssistant.App.Views"
             d:DataContext="{d:DesignInstance Type=vm:CommitmentsViewModel}"
             mc:Ignorable="d"
             Loaded="OnLoaded">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextMetaStyle}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Refresh.Hint}" Style="{StaticResource TextMetaStyle}" FontSize="11" Opacity="0.7"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Content="重新扫描" Command="{Binding LoadCommand}" Margin="16,0,0,0"
                    Style="{StaticResource GhostButtonStyle}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
        </StackPanel>

        <!-- 卡片列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Cursor="Hand"
                                ToolTip="点一下：看这条承诺所在的完整对话"
                                MouseLeftButtonUp="Card_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Style="{StaticResource TagTealStyle}">
                                        <TextBlock Text="待确认" Style="{StaticResource TextMicroStyle}"
                                                   Foreground="{StaticResource TagTealBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource TagAmberStyle}" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding KindTag}" Style="{StaticResource TextMicroStyle}"
                                                   Foreground="{StaticResource TagAmberBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Content}" Style="{StaticResource TextParagraphStyle}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource TextMicroStyle}">
                                    <Run Text="{Binding SessionName, Mode=OneWay}" /> · <Run Text="{Binding Date, Mode=OneWay}" />
                                    · 命中「<Run Text="{Binding MatchedText, Mode=OneWay}" />」
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空状态：规则初筛没命中时，说清"这是正常的 + 怎么提高命中" -->
        <views:EmptyStateView Grid.Row="1"
                              Icon="CheckmarkCircle24"
                              Title="没有扫到待确认的承诺"
                              Hint="承诺是规则初筛出来的线索，本来就允许为空；可以在对话页直接问「我答应过谁什么」。">
            <views:EmptyStateView.Visibility>
                <MultiBinding Converter="{StaticResource EmptyStateVisibility}">
                    <Binding Path="Cards" />
                    <Binding Path="IsBusy" />
                </MultiBinding>
            </views:EmptyStateView.Visibility>
        </views:EmptyStateView>
    </Grid>
</UserControl>
