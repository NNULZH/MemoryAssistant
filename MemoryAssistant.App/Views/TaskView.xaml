<UserControl x:Class="MemoryAssistant.App.Views.TaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MemoryAssistant.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MissionsViewModel}"
             mc:Ignorable="d">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="任务" Style="{StaticResource PageHeaderTitleStyle}" />
            <TextBlock Text="我的长期任务：它替我在后台盯着，到点或有事才动手（也可以直接在「对话」里说需求，我先出草案）"
                       Style="{StaticResource PageHeaderSubtitleStyle}" Margin="12,4,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：任务列表 + 新建 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="我的任务" Style="{StaticResource TextSectionStyle}" Margin="4,2,0,0" />
                            <TextBlock Text="{Binding MissionStatsText}" Style="{StaticResource TextMicroStyle}"
                                       Margin="4,4,0,0" />
                            <ListBox ItemsSource="{Binding Missions}" SelectedItem="{Binding SelectedMission}"
                                     Style="{StaticResource PlainListBoxStyle}"
                                     ItemContainerStyle="{StaticResource PlainListBoxItemStyle}"
                                     Margin="0,10,0,0" MaxHeight="330">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,8">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 状态点：运行中 / 已停止 / 异常，一眼看出在不在干活 -->
                                                <Border Style="{StaticResource StatusDotStyle}"
                                                        Background="{Binding StatusState, Converter={StaticResource StepStateToBrush}}" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding TriggerText}" Style="{StaticResource TextMicroStyle}"
                                                       Margin="16,5,0,0" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource TextMicroStyle}" Margin="16,3,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                                <Run Text=" · 已执行 " />
                                                <Run Text="{Binding RunCountText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding OriginText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- 新建任务（也可以直接对 Agent 说需求） -->
                    <Expander Header="新建任务（手工填写）" Style="{StaticResource FluentExpanderStyle}" Margin="0,0,0,12">
                        <StackPanel Margin="2,4,2,2">
                            <ui:TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="任务名称，如：追踪小明的聊天" MinHeight="32" />
                            <ui:TextBox Text="{Binding NewGoal, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="目标描述（Agent 要做什么）" MinHeight="32" Margin="0,8,0,0"
                                        AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="64" />
                            <ComboBox ItemsSource="{Binding TriggerOptions}"
                                      SelectedValue="{Binding NewTrigger}" SelectedValuePath="Kind"
                                      DisplayMemberPath="Label" Margin="0,8,0,0" Height="32" />
                            <ui:TextBox Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="追踪/回复对象（人名、群名，或会话里的词）" MinHeight="32" Margin="0,8,0,0"
                                        Visibility="{Binding NeedsTarget, Converter={StaticResource BoolToVisibility}}" />
                            <CheckBox Content="自动回复（创建后自动发送，不再逐条确认）"
                                      IsChecked="{Binding NewAutoReply}" Margin="0,10,0,0" />
                            <TextBlock Text="只回复对方发来的新消息；首次运行只记基线；可在配置里全局刹车。"
                                       Style="{StaticResource TextMicroStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <ui:TextBox Text="{Binding NewIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="巡检间隔：30（分钟）或 30秒 / 30s" MinHeight="32" Margin="0,8,0,0"
                                        Visibility="{Binding NeedsInterval, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="创建任务" Command="{Binding CreateMissionCommand}"
                                    Style="{StaticResource AccentButtonStyle}" Margin="0,12,0,0" Height="34" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- 右：详情 + 执行流程 + 执行历史 + 运行日志 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StatusDotStyle}"
                                        Background="{Binding StatusState, Converter={StaticResource StepStateToBrush}}" />
                                <TextBlock Text="{Binding SelectedMission.Title, FallbackValue=请选择一个任务}"
                                           Style="{StaticResource TextSectionStyle}" FontSize="17"
                                           Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border Style="{StaticResource TagTealStyle}" Margin="10,0,0,0"
                                        Visibility="{Binding IsAgentCreated, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Agent 创建" FontSize="10.5"
                                               Foreground="{StaticResource BrandBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- 关键字段：状态 / 创建方式 / 触发条件 / 执行次数 / 上次执行 -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="状态" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedMission.StatusText}" Style="{StaticResource TextBodyStyle}"
                                               Margin="0,3,0,0" />
                                    <!-- 正在跑的时候告诉用户"可以掐断"，否则他会以为只能等它跑完 -->
                                    <TextBlock Text="{Binding ExecutionStateText}" Style="{StaticResource TextMicroStyle}"
                                               Margin="0,3,0,0" Foreground="{StaticResource BrandBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="创建方式" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding OriginText}" Style="{StaticResource TextBodyStyle}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="执行次数" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding RunCountText}" Style="{StaticResource TextBodyStyle}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="触发条件" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding SelectedMission.TriggerText}" Style="{StaticResource TextBodyStyle}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="任务目标" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding SelectedMission.Goal}" Style="{StaticResource TextParagraphStyle}"
                                       Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="上次执行" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding LastRunAtText}" Style="{StaticResource TextBodyStyle}"
                                       Margin="0,3,0,0" />

                            <!-- 操作：立即执行 + **终止这一轮** + 启停 + 刷新 -->
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="立即执行一次" Command="{Binding RunNowCommand}"
                                        Style="{StaticResource AccentButtonStyle}" Height="34" Padding="18,0"
                                        IsEnabled="{Binding HasSelection}" />
                                <!-- 终止执行：掐断"正在跑的那一轮"（与「停止」= 停用任务分开）。
                                     跑飞了要能立刻掐断，而不用先把任务停掉再手动恢复；正在跑时才点得动。 -->
                                <Button Content="终止执行" Command="{Binding CancelRunCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Height="34" Padding="18,0" Margin="8,0,0,0"
                                        IsEnabled="{Binding IsExecutingNow}"
                                        ToolTip="掐断这个任务正在跑的那一轮；任务状态不变，下个周期照常执行" />
                                <Button Content="启动" Command="{Binding StartCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="18,0" Margin="8,0,0,0"
                                        IsEnabled="{Binding IsSchedulable}" />
                                <Button Content="停止" Command="{Binding StopCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="18,0" Margin="8,0,0,0"
                                        IsEnabled="{Binding IsSchedulable}"
                                        ToolTip="停用这个任务（移出后台巡检，可再启动）" />
                                <Button Content="刷新列表" Command="{Binding RefreshCommand}"
                                        Style="{StaticResource GhostButtonStyle}" Height="34" Padding="14,0" Margin="8,0,0,0" />
                                <!-- 删除任务：不可逆，放最右、视觉上与日常操作拉开距离（点了还会再确认一次） -->
                                <Button Content="删除任务" Command="{Binding DeleteMissionCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Height="34" Padding="18,0" Margin="24,0,0,0"
                                        IsEnabled="{Binding HasSelection}"
                                        ToolTip="删除这个任务本身，并连同它的执行记录一起删除" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 执行流程：按真实触发方式/动作描述每一轮怎么走 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="执行流程" Style="{StaticResource TextSectionStyle}" />
                            <TextBlock Text="{Binding FlowText}" Style="{StaticResource TextPreviewStyle}"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 最近一次执行结果 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="最近一次执行结果" Style="{StaticResource TextSectionStyle}" />
                            <TextBlock Text="{Binding LastResultText}" Style="{StaticResource TextParagraphStyle}"
                                       Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Expander Header="执行轨迹（最近一次）" Margin="0,12,0,0"
                                      Style="{StaticResource FluentExpanderStyle}"
                                      Visibility="{Binding LastTrace, Converter={StaticResource NullToCollapsedConverter}}">
                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding LastTrace}" Style="{StaticResource MonoTextStyle}" />
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- 执行记录（长期保存：可看全文 / 可删单条 / 可清空） -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="执行记录" Style="{StaticResource TextSectionStyle}" />
                                <Button Content="清空记录" Command="{Binding ClearRunsCommand}"
                                        Style="{StaticResource GhostButtonStyle}" Height="30" Padding="12,0" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding RunLocationNote}" Style="{StaticResource TextMicroStyle}"
                                           Margin="12,5,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            </StackPanel>
                            <TextBlock Text="{Binding RunNote}" Style="{StaticResource TextMicroStyle}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"
                                     Style="{StaticResource PlainListBoxStyle}"
                                     ItemContainerStyle="{StaticResource PlainListBoxItemStyle}"
                                     Margin="0,10,0,0" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AtText}" Style="{StaticResource TextMicroStyle}" />
                                                <TextBlock Text="{Binding MetaText}" Style="{StaticResource TextMicroStyle}"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource TextPreviewStyle}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 选中那一条的完整正文：**不截断**（"可查看"指的就是这里） -->
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding SelectedRun, Converter={StaticResource NullToCollapsedConverter}}">
                                <TextBlock Text="完整结果" Style="{StaticResource FieldLabelStyle}" />
                                <ui:TextBox Text="{Binding SelectedRun.Summary, Mode=OneWay}" IsReadOnly="True"
                                            TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="220"
                                            VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                                <Expander Header="执行轨迹" Style="{StaticResource FluentExpanderStyle}" Margin="0,10,0,0"
                                          Visibility="{Binding SelectedRun.HasTrace, Converter={StaticResource BoolToVisibility}}">
                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding SelectedRun.TraceText}" Style="{StaticResource MonoTextStyle}" />
                                    </ScrollViewer>
                                </Expander>
                                <Button Content="删除这一条" Command="{Binding DeleteRunCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Height="30" Padding="12,0"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 全部任务日志 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="全部任务日志" Style="{StaticResource TextSectionStyle}" />
                            <TextBlock Text="{Binding CapabilityNote}" Style="{StaticResource TextMicroStyle}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding Logs}" Style="{StaticResource PlainListBoxStyle}" Margin="0,10,0,0"
                                     MaxHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource TextPreviewStyle}" Margin="0,3" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
